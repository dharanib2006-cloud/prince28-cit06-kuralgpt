
# Copy this file to .env and fill in real values.
# The .env file must never be committed.

APP_NAME=kuralgpt
APP_ENV=local
LOG_LEVEL=INFO
DATA_FILE=data/sample_records.json

# PostgreSQL connection setting.
# Add your actual Neon or Supabase connection URL
# to your local .env file. Never commit that file.

# LLM keys (Day 8). Free keys: https://aistudio.google.com/apikey and https://console.groq.com/keys
# Real values go in .env, GitHub Secrets and Render only. Never in Git.
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY_MODEL=gemini-3.6-flash
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
